# Copier ce fichier en ".env" dans le même dossier que docker-compose.prod.yml sur le VPS
# (jamais commité — voir backend/README.md, section "Déploiement continu").

DB_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-random-secret-at-least-32-bytes
# Laisser vide une fois le premier PLATFORM_ADMIN créé via POST /api/v1/admin/bootstrap.
ADMIN_BOOTSTRAP_SECRET=
IMAGE_TAG=latest

# Email/SMS réels désactivés par défaut (LoggingVerificationNotifier log au lieu d'envoyer) —
# passer à true seulement une fois MAIL_*/SMS_* ci-dessous renseignés.
NOTIFICATIONS_ENABLED=false
# Compte SMTP du projet note-ta-boite (mail.notetaboite.com) — même host en dev et en prod,
# seul MAIL_FROM_NAME distingue l'expéditeur affiché.
MAIL_HOST=mail.notetaboite.com
MAIL_PORT=465
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM_NAME=Plateforme de Tâches Rémunérées
# Compte Djosend du projet mon-point (même API key/sender ID réutilisés).
SMS_API_KEY=change-me
SMS_SENDER_ID=MONPOINTCI
